	<controls>
		<control type="group">
			<right>36</right>
			<top>36</top>
			<width>520</width>
			<height>420</height>
			<control type="image">
				<width>520</width>
				<height>420</height>
				<texture>dialogs/dialog-bg-nobo.png</texture>
