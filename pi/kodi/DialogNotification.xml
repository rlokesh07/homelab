<?xml version="1.0" encoding="UTF-8"?>
<!-- Larger corner card so a doorbell snapshot can sit over playing video. -->
<window>
	<zorder>10</zorder>
	<controls>
		<control type="group">
			<depth>DepthMax</depth>
			<top>40</top>
			<right>24</right>
			<width>560</width>
			<include>OpenClose_Right</include>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>560</width>
				<height>480</height>
				<texture>dialogs/dialog-bg-nobo.png</texture>
				<bordertexture border="21" infill="false">overlays/shadow.png</bordertexture>
				<bordersize>20</bordersize>
			</control>
			<control type="image" id="400">
				<description>doorbell / avatar</description>
				<left>20</left>
				<top>20</top>
				<width>520</width>
				<height>360</height>
				<aspectratio>keep</aspectratio>
			</control>
			<control type="fadelabel" id="401">
				<description>Line 1 Label</description>
				<left>24</left>
				<top>390</top>
				<width>512</width>
				<height>30</height>
				<font>font32</font>
				<align>center</align>
				<aligny>center</aligny>
				<scrollout>false</scrollout>
				<pauseatend>2000</pauseatend>
			</control>
			<control type="fadelabel" id="402">
				<description>Line 2 Label</description>
				<left>24</left>
				<top>425</top>
				<width>512</width>
				<height>40</height>
				<font>font27_narrow</font>
				<align>center</align>
				<aligny>center</aligny>
				<scrollout>false</scrollout>
				<pauseatend>2000</pauseatend>
			</control>
		</control>
	</controls>
</window>
